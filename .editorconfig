root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 120

[*.{ts,tsx,js,jsx}]
indent_style = space
indent_size = 2

[*.{json,yml,yaml}]
indent_style = space
indent_size = 2

[*.{md,markdown}]
trim_trailing_whitespace = false

[*.{java,kts}]
indent_style = space
indent_size = 4

[Makefile]
indent_style = tab

[*.{xml}]
indent_style = space
indent_size = 2

[*.{pro,gradle}]
indent_style = space
indent_size = 4

[COMMIT_EDITMSG]
insert_final_newline = false