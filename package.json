{
  "name": "openplayer",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "description": "A free, open-source, offline-first Android music player. No ads, no tracking.",
  "keywords": [
    "music-player",
    "android",
    "open-source",
    "offline",
    "music",
    "audio-player",
    "equalizer",
    "lyrics",
    "queues",
    "fdroid"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/openplayer-project/openplayer.git"
  },
  "bugs": "https://github.com/openplayer-project/openplayer/issues",
  "homepage": "https://github.com/openplayer-project/openplayer#readme",
  "license": "MIT",
  "authors": [
    "OpenPlayer Contributors"
  ],
  "scripts": {
    "start": "expo start",
    "dev": "expo start --android",
    "prebuild:android": "expo prebuild --platform android --no-install",
    "build:android": "eas build --platform android",
    "build:apk": "eas build --platform android --profile preview",
    "lint": "eslint src app --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "prepare": "husky"
  },
  "dependencies": {
    "expo": "~51.0.0",
    "expo-router": "~3.5.0",
    "expo-sqlite": "~14.0.6",
    "expo-media-library": "~16.0.0",
    "expo-av": "~14.0.0",
    "expo-constants": "~16.0.0",
    "expo-linking": "~6.3.0",
    "react": "18.2.0",
    "react-native": "0.74.5",
    "react-native-gesture-handler": "~2.16.0",
    "react-native-reanimated": "~3.10.0",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1",
    "react-native-mmkv": "^2.12.0",
    "drizzle-orm": "~0.30.10",
    "zustand": "^4.5.0",
    "expo-status-bar": "~1.12.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/react": "~18.2.0",
    "typescript": "~5.3.0",
    "eslint": "^8.57.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint-plugin-react-native": "^4.1.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "husky": "^9.0.0",
    "jest": "^29.7.0",
    "@testing-library/react-native": "^12.4.0",
    "jest-expo": "~51.0.4",
    "@types/jest": "^29.5.12",
    "prettier": "^3.3.0",
    "eslint-config-prettier": "^9.1.0",
    "react-test-renderer": "18.2.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    }
  }
}
